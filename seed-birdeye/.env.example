# ══════════════════════════════════════════════════════════════════
# SEED-BIRDEYE — Variables de arranque. La config de negocio (A–L)
# vive en la DB y se edita desde la UI (GET/PATCH /api/config).
# ══════════════════════════════════════════════════════════════════
DB_URL=sqlite+aiosqlite:///./data/seed.db
LOG_LEVEL=INFO
CORS_ORIGINS=["http://localhost:3000"]
HTTPS_ONLY=false
RATE_LIMIT_PER_MIN=60

# ── Criptografía (OBLIGATORIO en producción) ──
MASTER_KEY=

# ── Seed del admin ──
ADMIN_EMAIL=admin@seed.local
ADMIN_PASSWORD=changeme-1234

# ── Secretos de integración (se cifran en DB al primer arranque) ──
BIRDEYE_API_KEY=
WALLET_PRIVATE_KEY=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
AGENT_API_KEY=
AGENT_PROVIDER=grok
AGENT_BASE_URL=https://api.x.ai/v1
